# k6 environment overrides (safe defaults, no secrets in this repo).
#
# k6 does NOT read .env files on its own. Copy this file to .env for
# reference, then export the values you need in your shell, or pass
# them inline when you run a test:
#   REST_BASE_URL=https://jsonplaceholder.typicode.com k6 run scripts/load-test.js
#
# If a key is unset, the defaults in config/environments.js are used.

# Which environment table to use from config/environments.js: dev or prod.
K6_ENV=dev

# Base URL of the main API under test (default: https://jsonplaceholder.typicode.com).
REST_BASE_URL=https://jsonplaceholder.typicode.com

# Base URL of the second demo host (default: https://httpbin.org).
HTTPBIN_BASE_URL=https://httpbin.org
